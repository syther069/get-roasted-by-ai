from genlayer import *

class RoastConsensus(Contract):

    def __init__(self):

        self.roasts = []

        self.top_score = 0

        self.top_roast = ""

    @external
    def submit_roast(
        self,
        user: str,
        input_text: str,
        final_roast: str,
        score: int,
        validator: str,
        confidence: int,
        reasoning: str
    ):

        roast_data = {
            "id": len(self.roasts),
            "user": user,
            "input": input_text,
            "roast": final_roast,
            "score": score,
            "validator": validator,
            "confidence": confidence,
            "reasoning": reasoning,
            "timestamp": block.timestamp()
        }

        self.roasts.append(roast_data)

        if score > self.top_score:
            self.top_score = score
            self.top_roast = final_roast

    @view
    def get_all_roasts(self) -> list:
        return self.roasts

    @view
    def get_top_roast(self) -> dict:

        return {
            "score": self.top_score,
            "roast": self.top_roast
        }

    @view
    def get_roast_count(self) -> int:
        return len(self.roasts)